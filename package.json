{
  "name": "gatorsqoosh",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Batch image compression for Windows and macOS",
  "author": "GatorSqoosh contributors",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "test:folders": "node tests/folder-desktop.cjs",
    "pack": "vite build && electron-builder --dir",
    "dist:win": "vite build && electron-builder --win zip",
    "dist:mac": "vite build && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/webp": "1.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "io.github.mcbasketballcranjis.gatorsqoosh",
    "productName": "GatorSqoosh",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "licenses/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.photography",
      "identity": null
    },
    "artifactName": "GatorSqoosh-${version}-${os}-${arch}.${ext}"
  }
}
