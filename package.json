{
  "name": "chomp",
  "version": "2.1.4",
  "private": true,
  "type": "module",
  "description": "Local image compression and SVG vector tracing for Windows and macOS",
  "author": "Chomp contributors",
  "license": "Apache-2.0",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/icons.mjs && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node tests/desktop.cjs",
    "test:vector": "node tests/vector-desktop.cjs",
    "test:folders": "node tests/folder-desktop.cjs",
    "pack": "node scripts/icons.mjs && vite build && electron-builder --dir --publish never",
    "dist:win": "node scripts/icons.mjs && vite build && electron-builder --win nsis portable zip --publish never && node scripts/prepare-update-metadata.mjs",
    "dist:mac": "node scripts/icons.mjs && node scripts/prepare-mac-icon.mjs && vite build && electron-builder --mac dmg zip --publish never",
    "icons": "node scripts/icons.mjs",
    "test:appearance": "node tests/appearance-size.cjs",
    "test:package": "node scripts/verify-package.mjs",
    "verify:updates": "node scripts/verify-update-metadata.mjs"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/oxipng": "2.3.0",
    "@jsquash/webp": "1.5.0",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "sharp": "0.35.5",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "io.github.mcbasketballcranjis.chomp",
    "productName": "Chomp",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "THIRD_PARTY_NOTICES.md",
      "LICENSE",
      "licenses/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "nsis",
        "portable",
        "zip"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.photography",
      "identity": "-",
      "icon": "build/chomp.icon",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist"
    },
    "artifactName": "Chomp-${version}-${os}-${arch}.${ext}",
    "compression": "normal",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Chomp-${version}-win-${arch}-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "allowElevation": false,
      "packElevateHelper": false,
      "include": "installer/migrate.nsh"
    },
    "dmg": {
      "contents": [
        {
          "x": 140,
          "y": 160,
          "type": "file"
        },
        {
          "x": 420,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 340
      },
      "icon": "build/icon.icns"
    },
    "portable": {
      "artifactName": "Chomp-${version}-win-${arch}-Portable.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mcbasketball-cranjis",
        "repo": "chomp",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "electron/mac-replace.sh",
        "to": "mac-replace.sh"
      }
    ]
  }
}
